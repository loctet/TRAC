/*
This DAFSM models a fundraising process where an `Owner` 
starts a campaign with a goal. 
`Users` can join and deposit funds while the campaign 
is active and the goal is not yet reached. 
Once the goal is met, the `Owner` triggers 
an inspection phase by two `Agents`. 
After both `Agents` complete their inspections, 
any `Agent` can close the campaign. 
Once closed, owner can withdraw. 
*/
roles Onwer User Agent
dafsm fundraising(int _goal) by Onwer o { 
int goal := _goal; 
bool status := False; 
int balance := 0;
if _goal > 0  
}
[q0] {And(status, _amount > 0, balance < goal)} 
new User u > deposit(int _amount) {balance := balance + _amount}
[q0]
[q0] {And(status, balance >= goal)} o > 
	sendInspection(Agent a1, Agent a2) 
[q1]
[q1] a1 > inspect() {} [q2]
[q2] a2 > inspect() {} [q3]
[q3] any Agent a > close() {status := True} [q4+]
[q4] {balance == _amount}o > withdraw(int _amount) 
{balance := 0;} 
[q4+]