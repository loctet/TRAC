/*
This DAFSM models a voting process where a Creator sets a deadline. 
Users can join as Voters and vote before the deadline. 
After the deadline, the Creator register three Consultants who must each validate the result. 
Once three validations are done, the Creator can close the vote.
For simplicity we don't store voters or Consultants, 
we assume all new or any call is made by different participant.
*/
roles Creator Voter Consultant
dafsm Voting(int _deadline, int _time) by Creator c {
  int deadline := _deadline;
  int voters := 0;
  int c_approvals := 0;
  if And(_deadline > _time, _deadline > 0)
}
[q0] {deadline >= _time} new v : Voter > vote(int _time) 
{ voters := voters +1 } 
[q0]

[q0] {deadline < _time} c > closevoting(Consultant c1, Consultant c2, Consultant c3, int _time) {} 
[q1]

[q1] {c_approvals < 2} any c : Consultant > validate() {c_approvals := c_approvals +1 } [q1]

[q1] {c_approvals == 2} any c : Consultant > validate() {c_approvals := c_approvals +1 } [q2]

[q2] {c_approvals == 3} c > Close(int _time) {} [qf+]