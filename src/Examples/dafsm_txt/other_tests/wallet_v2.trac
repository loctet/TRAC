roles Creator User
dafsm Wallet(User u, int _initial, int _deadline) by Creator c {
  int balance := _initial;
  int deadline := _deadline;
  if And(_initial> 0, _deadline> 0)
}
[q0] c > GrantRight(User u) {} [q0]

[q0] {And( _time <= deadline, _amount> 0)} any u : User > Deposit(int _amount, int _time) {balance := balance + _amount} [q0]

[q0] {And( _time <= deadline, _amount> 0)} any u : User  > Withdraw(int _amount, int _time) {
  balance := balance - _amount;
} [q0]

[q0] {And( _time <= deadline, _amount> 0)} c > Deposit(int _amount, int _time) {balance := balance + _amount} [q0]

[q0] {And( _time <= deadline, _amount> 0)} c > Withdraw(int _amount, int _time) {
  balance := balance - _amount;
} [q0]

[q0] {Or(balance <= 0, _time >= deadline)} c > Close(int _time) {} [qf+]
